{
  "name": "@emmettito/canvas",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/canvas.js"
    },
    "./prosemirror": {
      "types": "./dist/types/prosemirror.d.ts",
      "default": "./dist/prosemirror.js"
    },
    "./collaboration-server": {
      "types": "./dist/types/collaboration-server.d.ts",
      "default": "./dist/collaboration-server.js"
    },
    "./styles.css": "./dist/canvas.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.lib.json && node scripts/strip-css-imports.ts",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:e2e": "vite build --mode e2e",
    "prepare": "npm run build",
    "icons": "node scripts/generate-icons.ts",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "preview": "vite preview --outDir dist-demo",
    "prepublishOnly": "node -e \"console.error('Publishing to npm is disabled for now.'); process.exit(1)\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "packageManager": "npm@12.2.1",
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.8",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.8"
  },
  "peerDependenciesMeta": {
    "prosemirror-commands": {
      "optional": true
    },
    "prosemirror-history": {
      "optional": true
    },
    "prosemirror-keymap": {
      "optional": true
    },
    "prosemirror-model": {
      "optional": true
    },
    "prosemirror-state": {
      "optional": true
    },
    "prosemirror-view": {
      "optional": true
    }
  },
  "allowScripts": {
    "fsevents": false
  }
}
