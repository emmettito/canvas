{
  // Emits type declarations for the library. Type-checking is done by
  // `tsconfig.app.json`.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "rootDir": "./src"
  },
  "include": ["src"],
  // The demo page's files.
  "exclude": [
    "src/main.ts",
    "src/settings.ts",
    "src/share.ts",
    "src/theme.ts",
    "src/demo-icons.ts",
    "src/**/*.test.ts"
  ]
}
